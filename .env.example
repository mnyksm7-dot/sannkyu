# Google Gemini API キー（gemini-2.5-flash-image = 通称 Nano Banana を使用）
# https://aistudio.google.com/apikey で発行してください
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意: 使用する画像生成モデルを差し替えたい場合に指定
# 例: gemini-2.5-flash-image（デフォルト） / gemini-3.1-flash-image / gemini-3-pro-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
